{
  "datasets": [
    {
      "name": "d5fc2a9a",
      "displayName": "kpis",
      "queryLines": [
        "SELECT\r\n",
        "  COUNT(*)                          AS contratos,\r\n",
        "  COUNT(DISTINCT proveedor_id)      AS proveedores,\r\n",
        "  COUNT(DISTINCT institucion_id)    AS instituciones,\r\n",
        "  ROUND(SUM(monto_contrato))        AS monto_total,\r\n",
        "  ROUND(AVG(monto_contrato))        AS ticket_promedio\r\n",
        "FROM compras_rd.gold.fact_contratos\r\n",
        "WHERE NOT flag_monto_invalido AND moneda = 'DOP'"
      ]
    },
    {
      "name": "3e4a7158",
      "displayName": "gasto_mensual",
      "queryLines": [
        "SELECT\r\n",
        "  make_date(df.anio, df.mes, 1)  AS mes_fecha,\r\n",
        "  di.institucion,\r\n",
        "  ROUND(SUM(fc.monto_contrato))  AS monto_total\r\n",
        "FROM compras_rd.gold.fact_contratos fc\r\n",
        "LEFT JOIN compras_rd.gold.dim_fecha df       ON fc.fecha_key = df.fecha_key\r\n",
        "LEFT JOIN compras_rd.gold.dim_institucion di ON fc.institucion_id = di.institucion_id\r\n",
        "WHERE NOT fc.flag_monto_invalido AND fc.moneda = 'DOP'\r\n",
        "GROUP BY make_date(df.anio, df.mes, 1), di.institucion"
      ]
    },
    {
      "name": "2c74352f",
      "displayName": "top_instituciones",
      "queryLines": [
        "SELECT institucion, num_contratos, ROUND(monto_total) AS monto_total\r\n",
        "FROM compras_rd.gold.agg_gasto_institucion\r\n",
        "WHERE moneda = 'DOP'\r\n",
        "ORDER BY monto_total DESC\r\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "872e416d",
      "displayName": "modalidades",
      "queryLines": [
        "SELECT COALESCE(m.modalidad, 'sin dato') AS modalidad,\r\n",
        "       COUNT(*) AS contratos,\r\n",
        "       ROUND(SUM(fc.monto_contrato)) AS monto_total\r\n",
        "FROM compras_rd.gold.fact_contratos fc\r\n",
        "LEFT JOIN compras_rd.gold.dim_modalidad m ON fc.modalidad_key = m.modalidad_key\r\n",
        "WHERE NOT fc.flag_monto_invalido AND fc.moneda = 'DOP'\r\n",
        "GROUP BY m.modalidad"
      ]
    },
    {
      "name": "d31dfc84",
      "displayName": "escala",
      "queryLines": [
        "SELECT COALESCE(p.escala, 'sin dato') AS escala,\r\n",
        "       COUNT(*) AS contratos,\r\n",
        "       ROUND(SUM(fc.monto_contrato)) AS monto_total\r\n",
        "FROM compras_rd.gold.fact_contratos fc\r\n",
        "LEFT JOIN compras_rd.gold.dim_proveedor p ON fc.proveedor_id = p.proveedor_id\r\n",
        "WHERE NOT fc.flag_monto_invalido AND fc.moneda = 'DOP'\r\n",
        "GROUP BY p.escala"
      ]
    },
    {
      "name": "66d4d4a4",
      "displayName": "genero",
      "queryLines": [
        "SELECT COALESCE(p.genero, 'sin dato') AS genero,\r\n",
        "       COUNT(*) AS contratos,\r\n",
        "       ROUND(SUM(fc.monto_contrato)) AS monto_total\r\n",
        "FROM compras_rd.gold.fact_contratos fc\r\n",
        "LEFT JOIN compras_rd.gold.dim_proveedor p ON fc.proveedor_id = p.proveedor_id\r\n",
        "WHERE NOT fc.flag_monto_invalido AND fc.moneda = 'DOP'\r\n",
        "GROUP BY p.genero\r\n"
      ]
    },
    {
      "name": "37d10d32",
      "displayName": "top_proveedores",
      "queryLines": [
        "SELECT nombre, escala, num_contratos,\r\n",
        "       ROUND(monto_total) AS monto_total,\r\n",
        "       ROUND(participacion, 4) AS participacion\r\n",
        "FROM compras_rd.gold.agg_proveedores\r\n",
        "WHERE moneda = 'DOP'\r\n",
        "ORDER BY monto_total DESC\r\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "4a6d56f0",
      "displayName": "tiempos",
      "queryLines": [
        "SELECT\r\n",
        "  COALESCE(m.modalidad, 'sin dato')                    AS modalidad,\r\n",
        "  COUNT(*)                                             AS procesos,\r\n",
        "  percentile_approx(fp.dias_hasta_adjudicacion, 0.5)   AS dias_mediana\r\n",
        "FROM compras_rd.gold.fact_procesos fp\r\n",
        "LEFT JOIN compras_rd.gold.dim_modalidad m ON fp.modalidad_key = m.modalidad_key\r\n",
        "WHERE fp.dias_hasta_adjudicacion >= 0\r\n",
        "GROUP BY m.modalidad\r\n",
        "HAVING COUNT(*) >= 30"
      ]
    },
    {
      "name": "63f21e0a",
      "displayName": "proveedoresxregion",
      "queryLines": [
        "SELECT COALESCE(region, 'sin dato') AS region, COUNT(*) AS proveedores\r\n",
        "FROM compras_rd.gold.dim_proveedor\r\n",
        "GROUP BY region\r\n",
        "ORDER BY proveedores DESC;"
      ]
    }
  ],
